# ==============================================================
# Kisan Saathi (ಕಿಸಾನ್ ಸಾಥಿ) - Environment Configuration
# ==============================================================

# Port configuration
PORT=5000

# GEMINI_API_KEY: Grounded explanations and agricultural guidance
GEMINI_API_KEY=""

# APP_URL: Client origin for CORS
APP_URL="http://localhost:3000"

# FRONTEND API BASE URL
# For Vite dev proxy: /api
# For Java Spring Boot: http://localhost:8080/api
# For Node Express API: http://localhost:5000/api
VITE_API_BASE_URL="/api"
VITE_AI_CHAT_API_URL="/api/eligibility-chat"

# JWT AUTHENTICATION SECRET
JWT_SECRET="kisan-saathi-production-jwt-secret-secure-key-2026"

# SMS OTP PROVIDER CONFIGURATION (msg91 | twilio | fast2sms)
SMS_PROVIDER=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID="KSNSAT"

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

FAST2SMS_API_KEY=""

# POSTGRESQL CONFIGURATION
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="kisan_saathi_db"
DB_USER="postgres"
DB_PASSWORD="postgres"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kisan_saathi_db"
